<!-- Armar card de un solo producto con boton de apgregar al carrito -->
<div class="container">
    <div class="row">
        <div class="col-4">
            <div class="card" style="width: 18rem;">
                <img src="{{img}}" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title
                    ">{{product.nombre}}</h5>
                    <p class="card-text">{{product.descripcion}}</p>
                    <p class="card-text">{{product.precio}}</p>
                    <a href="/products/{{product._id}}/cart" class="btn btn-primary">Agregar al carrito</a>
                </div>
            </div>
        </div>
    </div>
</div>