<div class="container my-4">
    <div class="row g-4">
        {{#each products}}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <img src="{{img}}" class="card-img-top" alt="Imagen del producto {{nombre}}">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">{{nombre}}</h5>
                        <p class="card-text text-muted mb-2">{{descripcion}}</p>
                        <p class="card-text fw-bold text-primary">Precio: ${{precio}}</p>
                        <a href="/products/{{_id}}" class="btn btn-primary mt-auto">Ver más</a>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>
    