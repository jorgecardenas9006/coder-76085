<div class="container my-4">
    <div class="row g-4">
        {{#each products}}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-img-container">
                        <img src="{{img}}" class="card-img-top img-fluid" alt="Imagen del producto {{nombre}}">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate">{{nombre}}</h5>
                        <p class="card-text text-muted mb-2">{{descripcion}}</p>
                        <p class="card-text fw-bold text-primary">Precio: ${{precio}}</p>
                        <a href="products/{{_id}}" class="btn btn-primary mt-auto">Ver más</a>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>
<!-- Boton para ir carrito de compras -->
<div class="container d-flex justify-content-center align-items-center">
    <div class="row">
        <div class="col-12">
            <a href="http://localhost:3000/api/v1/carts/676a3de37e4ff41f14e66ab4" class="btn btn-primary w-100">Ir al carrito</a>
        </div>
    </div>
</div>