<!-- Vista del carrito de compras -->
<div class="container my-4">
    <div class="row">
        <div class="col-12">
            <h1 class="text-center">Carrito de compras</h1>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Precio</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Subtotal</th>
                        <th scope="col">Acciones</th>
                        <th scope="col">Borrar</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each productos}}
                        {{#each this}}
                        <tr>
                            <td>{{producto.nombre}}</td>
                            <td>${{producto.precio}}</td>
                            <td>{{this.cantidad}}</td>
                            <td>${{this.subtotal}}</td>
                            <td>
                                <a href="/cart/{{this.producto._id}}/add" class="btn btn-primary">+</a>
                                <a href="/cart/{{this.producto._id}}/remove" class="btn btn-danger">-</a>
                            </td>
                            <td class="flex">
                                <a target="_blank" title="Más información sobre la canasta de basura" class="justify-content-center" onclick="borrarProducto('{{this.producto._id}}')">
                                    <svg 
                                    xmlns="http://www.w3.org/2000/svg" 
                                    viewBox="0 0 64 64" 
                                    width="30" 
                                    height="30" 
                                    fill="gray">
                                    <!-- Base de la canasta -->
                                    <rect x="16" y="20" width="32" height="40" rx="4" ry="4" />
                                    <!-- Tapa de la canasta -->
                                    <rect x="12" y="10" width="40" height="10" rx="2" ry="2" />
                                    <!-- Líneas de separación -->
                                    <line x1="20" y1="25" x2="20" y2="55" stroke="white" stroke-width="2" />
                                    <line x1="32" y1="25" x2="32" y2="55" stroke="white" stroke-width="2" />
                                    <line x1="44" y1="25" x2="44" y2="55" stroke="white" stroke-width="2" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                        {{/each}}
                    {{/each}}
                </tbody>
            </table>
            <h3 class="text-center">Total: ${{total}}</h3>
            <a href="/cart/checkout" class="btn btn-success w-100">Finalizar compra</a>
        </div>
    </div>
</div>
<script>
    const borrarProducto = (id) => {
        fetch(`http://localhost:3000/api/v1/carts/676c8f23dc8c7201dbc1f3fc/products/${id}`, {
            method: "DELETE",
            headers: {
                "Content-Type": "application/json"
            }
        })
        .then((response) => response.text())
        .then((result) => console.log(result))
    };

</script>
